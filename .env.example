# VirusTotal Public API (free community key)
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Where store.json / uploads / media live. Default: ./data. On Railway the image uses /data (mount a volume there).
# VIBE_DATA_DIR=/data

# GitHub sign-in and repository import (optional). Callback URL: <APP_URL>/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APP_URL=https://your-domain.example
